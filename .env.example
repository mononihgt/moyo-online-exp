# 复制为 .env 后填写真实值：cp .env.example .env && chmod 600 .env
# .env 已被 git 和 Docker 构建上下文忽略，不能提交到仓库。
# 域名只写主机名，不要带协议、端口或路径。

APP_DOMAIN=game.example.com
PUBLIC_BASE_URL=https://${APP_DOMAIN}

JATOS_DOMAIN=jatos.example.com
JATOS_BASE_URL=https://${JATOS_DOMAIN}

# 生成：openssl rand -hex 32
SECRET_KEY=
# 生成：openssl rand -hex 32
PHONE_HMAC_KEY=
# 生成：openssl rand -base64 32 | tr '+/' '-_'
PHONE_ENCRYPTION_KEY=
# 受保护问卷字段（真实姓名、支付宝手机号、身份证明）的加密密钥。
# 生成：openssl rand -base64 32 | tr '+/' '-_'
# 更换密钥会导致已保存的身份信息无法解密，必须与备份一起妥善保存。
IDENTITY_ENCRYPTION_KEY=

# 数据库密码只使用十六进制字符，避免 DATABASE_URL 和 SQL 中的转义问题。
# 生成：openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
# 生成：openssl rand -hex 24
MYSQL_PASSWORD=
# Docker Compose 在读取 .env 时用上一行的 MYSQL_PASSWORD 插值生成。
DATABASE_URL=mysql+aiomysql://moyo:${MYSQL_PASSWORD}@db:3306/moyo?charset=utf8mb4
# 生成：openssl rand -hex 24
JATOS_DB_PASSWORD=

ADMIN_USERNAME=admin
# 生成：openssl rand -hex 16
ADMIN_INITIAL_PASSWORD=

# 完成 JATOS 配置后填写
JATOS_STUDY_CODE=
JATOS_API_TOKEN=
# 生成：openssl rand -hex 32
JATOS_SECRET=

COOKIE_SECURE=true
LOG_LEVEL=INFO
TZ=Asia/Shanghai
